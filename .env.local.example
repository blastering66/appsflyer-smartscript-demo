# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AppsFlyer OneLink base URL (e.g. https://yourbrand.onelink.me/XXXX)
NEXT_PUBLIC_AF_ONELINK_URL=https://yourbrand.onelink.me/XXXX

# iOS App Store app ID (e.g. id123456789)
NEXT_PUBLIC_IOS_APP_ID=id123456789

# Android package name (e.g. com.yourapp.android)
NEXT_PUBLIC_ANDROID_PKG=com.yourapp.android
